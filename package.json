{
  "name": "context-optimizer",
  "displayName": "Context Optimizer",
  "description": "Automatically compresses your project context into optimized AI prompts — saving up to 95% of tokens when switching AI assistants.",
  "version": "1.0.0",
  "publisher": "context-optimizer",
  "repository": {
    "type": "git",
    "url": "https://github.com/context-optimizer/context-optimizer"
  },
  "bugs": {
    "url": "https://github.com/context-optimizer/context-optimizer/issues"
  },
  "homepage": "https://github.com/context-optimizer/context-optimizer#readme",
  "license": "MIT",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#0d1117",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Machine Learning",
    "Snippets"
  ],
  "keywords": [
    "ai",
    "context",
    "tokens",
    "chatgpt",
    "claude",
    "copilot",
    "prompt",
    "memory",
    "compression",
    "productivity"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "contextOptimizer",
          "title": "Context Optimizer",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "contextOptimizer": [
        {
          "id": "contextOptimizer.summaryView",
          "name": "Project Memory",
          "icon": "$(sparkle)",
          "contextualTitle": "Context Optimizer"
        },
        {
          "id": "contextOptimizer.decisionChat",
          "name": "Decision Log",
          "icon": "$(comment-discussion)",
          "contextualTitle": "Context Optimizer"
        },
        {
          "id": "contextOptimizer.filesView",
          "name": "Key Files",
          "icon": "$(files)",
          "contextualTitle": "Context Optimizer"
        },
        {
          "id": "contextOptimizer.statsView",
          "name": "Token Savings",
          "icon": "$(graph)",
          "contextualTitle": "Context Optimizer"
        },
        {
          "id": "contextOptimizer.graphsView",
          "name": "Codebase Visualizer",
          "icon": "$(eye)",
          "contextualTitle": "Context Optimizer"
        }
      ]
    },
    "commands": [
      {
        "command": "contextOptimizer.generateContext",
        "title": "Generate Context",
        "category": "Context Optimizer",
        "icon": "$(sparkle)"
      },
      {
        "command": "contextOptimizer.updateContext",
        "title": "Update Context",
        "category": "Context Optimizer",
        "icon": "$(sync)"
      },
      {
        "command": "contextOptimizer.showDiff",
        "title": "Show What Changed (Memory Diff)",
        "category": "Context Optimizer",
        "icon": "$(diff)"
      },
      {
        "command": "contextOptimizer.showWelcome",
        "title": "Show Welcome Walkthrough",
        "category": "Context Optimizer",
        "icon": "$(info)"
      },
      {
        "command": "contextOptimizer.importChat",
        "title": "Import AI Chat Conversation",
        "category": "Context Optimizer",
        "icon": "$(sign-in)"
      },
      {
        "command": "contextOptimizer.exportPrompt",
        "title": "Export Optimized Prompt",
        "category": "Context Optimizer",
        "icon": "$(export)"
      },
      {
        "command": "contextOptimizer.exportMarkdown",
        "title": "Export as Markdown",
        "category": "Context Optimizer",
        "icon": "$(markdown)"
      },
      {
        "command": "contextOptimizer.exportJson",
        "title": "Export as JSON",
        "category": "Context Optimizer",
        "icon": "$(json)"
      },
      {
        "command": "contextOptimizer.exportGraph",
        "title": "Export Context Graph",
        "category": "Context Optimizer",
        "icon": "$(graph)"
      },
      {
        "command": "contextOptimizer.showTokenSavings",
        "title": "Show Token Savings",
        "category": "Context Optimizer",
        "icon": "$(graph-line)"
      },
      {
        "command": "contextOptimizer.openDashboard",
        "title": "Open Dashboard",
        "category": "Context Optimizer",
        "icon": "$(dashboard)"
      },
      {
        "command": "contextOptimizer.openInteractiveGraph",
        "title": "Open Interactive Codebase Graph",
        "category": "Context Optimizer",
        "icon": "$(graph)"
      },
      {
        "command": "contextOptimizer.openMermaidGraph",
        "title": "Open Codebase Visual Graph (Flowchart)",
        "category": "Context Optimizer",
        "icon": "$(graph)"
      },
      {
        "command": "contextOptimizer.resetMemory",
        "title": "Reset Memory",
        "category": "Context Optimizer",
        "icon": "$(trash)"
      },
      {
        "command": "contextOptimizer.addNote",
        "title": "Add Developer Note",
        "category": "Context Optimizer",
        "icon": "$(note)"
      },
      {
        "command": "contextOptimizer.addRule",
        "title": "Add Project Rule",
        "category": "Context Optimizer",
        "icon": "$(law)"
      },
      {
        "command": "contextOptimizer.detectDuplicates",
        "title": "Detect Duplicate / Dead Code",
        "category": "Context Optimizer",
        "icon": "$(search)"
      },
      {
        "command": "contextOptimizer.generateReadme",
        "title": "Generate README",
        "category": "Context Optimizer",
        "icon": "$(book)"
      },
      {
        "command": "contextOptimizer.generateAiArchitectureSummary",
        "title": "Generate AI Project Summary",
        "category": "Context Optimizer",
        "icon": "$(sparkle)"
      },
      {
        "command": "contextOptimizer.refresh",
        "title": "Refresh",
        "category": "Context Optimizer",
        "icon": "$(refresh)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "contextOptimizer.generateContext",
          "when": "view == contextOptimizer.summaryView",
          "group": "navigation@1"
        },
        {
          "command": "contextOptimizer.updateContext",
          "when": "view == contextOptimizer.summaryView",
          "group": "navigation@2"
        },
        {
          "command": "contextOptimizer.showDiff",
          "when": "view == contextOptimizer.summaryView",
          "group": "navigation@3"
        },
        {
          "command": "contextOptimizer.refresh",
          "when": "view == contextOptimizer.summaryView",
          "group": "navigation@4"
        },
        {
          "command": "contextOptimizer.openDashboard",
          "when": "view == contextOptimizer.summaryView",
          "group": "navigation@5"
        },
        {
          "command": "contextOptimizer.openInteractiveGraph",
          "when": "view == contextOptimizer.summaryView",
          "group": "navigation@6"
        },
        {
          "command": "contextOptimizer.exportGraph",
          "when": "view == contextOptimizer.summaryView",
          "group": "navigation@7"
        },
        {
          "command": "contextOptimizer.exportPrompt",
          "when": "view == contextOptimizer.filesView",
          "group": "navigation@1"
        },
        {
          "command": "contextOptimizer.exportGraph",
          "when": "view == contextOptimizer.filesView",
          "group": "navigation@2"
        },
        {
          "command": "contextOptimizer.openInteractiveGraph",
          "when": "view == contextOptimizer.graphsView",
          "group": "navigation@1"
        },
        {
          "command": "contextOptimizer.openMermaidGraph",
          "when": "view == contextOptimizer.graphsView",
          "group": "navigation@2"
        },
        {
          "command": "contextOptimizer.exportGraph",
          "when": "view == contextOptimizer.graphsView",
          "group": "navigation@3"
        }
      ],
      "commandPalette": [
        {
          "command": "contextOptimizer.generateContext"
        },
        {
          "command": "contextOptimizer.updateContext"
        },
        {
          "command": "contextOptimizer.showDiff"
        },
        {
          "command": "contextOptimizer.showWelcome"
        },
        {
          "command": "contextOptimizer.importChat"
        },
        {
          "command": "contextOptimizer.exportPrompt"
        },
        {
          "command": "contextOptimizer.exportMarkdown"
        },
        {
          "command": "contextOptimizer.exportJson"
        },
        {
          "command": "contextOptimizer.exportGraph"
        },
        {
          "command": "contextOptimizer.showTokenSavings"
        },
        {
          "command": "contextOptimizer.openDashboard"
        },
        {
          "command": "contextOptimizer.openInteractiveGraph"
        },
        {
          "command": "contextOptimizer.openMermaidGraph"
        },
        {
          "command": "contextOptimizer.resetMemory"
        },
        {
          "command": "contextOptimizer.addNote"
        },
        {
          "command": "contextOptimizer.addRule"
        },
        {
          "command": "contextOptimizer.detectDuplicates"
        },
        {
          "command": "contextOptimizer.generateReadme"
        },
        {
          "command": "contextOptimizer.generateAiArchitectureSummary"
        },
        {
          "command": "contextOptimizer.refresh"
        }
      ]
    },
    "keybindings": [
      {
        "command": "contextOptimizer.openInteractiveGraph",
        "key": "ctrl+alt+g",
        "mac": "cmd+alt+g"
      }
    ],
    "configuration": {
      "title": "Context Optimizer",
      "properties": {
        "contextOptimizer.autoUpdateOnSave": {
          "type": "boolean",
          "default": true,
          "description": "Automatically update context memory when files are saved."
        },
        "contextOptimizer.autoUpdateOnCommit": {
          "type": "boolean",
          "default": true,
          "description": "Update context memory after each git commit."
        },
        "contextOptimizer.maxFileSizeKb": {
          "type": "number",
          "default": 500,
          "description": "Maximum file size (KB) to analyze. Larger files will be skipped."
        },
        "contextOptimizer.outputDirectory": {
          "type": "string",
          "default": ".vscode/context-optimizer",
          "description": "Directory (relative to workspace root) where memory and exports are stored."
        },
        "contextOptimizer.ignorePatterns": {
          "type": "array",
          "default": [
            "node_modules",
            "dist",
            "build",
            ".git",
            ".cache",
            "*.log",
            "*.png",
            "*.jpg",
            "*.jpeg",
            "*.gif",
            "*.svg",
            "*.mp4",
            "*.mp3",
            "*.webp",
            "coverage",
            ".nyc_output",
            "__pycache__",
            "*.pyc",
            ".venv",
            "venv",
            "target",
            ".next",
            ".nuxt",
            "out",
            "public/assets"
          ],
          "description": "Glob patterns to ignore during project scanning."
        },
        "contextOptimizer.aiSummarization": {
          "type": "boolean",
          "default": false,
          "description": "Use LLM (Groq) to generate high-quality one-sentence summaries for complex files (>50 lines)."
        },
        "contextOptimizer.groqApiKey": {
          "type": "string",
          "default": "",
          "description": "Groq API Key (gsk_...) for AI-based features. Keep empty to fall back to heuristics."
        },
        "contextOptimizer.groqModel": {
          "type": "string",
          "default": "llama-3.1-8b-instant",
          "description": "Groq model to use for file analysis and prompt optimization."
        },
        "contextOptimizer.tokenBudget": {
          "type": "number",
          "default": 4000,
          "description": "Target token budget limit for AI prompt export (e.g. 2000, 4000, 8000)."
        },
        "contextOptimizer.autoRedactSecrets": {
          "type": "boolean",
          "default": true,
          "description": "Automatically redact API keys, secrets, and credentials before exporting context prompts."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "tsc -p ./tsconfig.json",
    "watch": "tsc -watch -p ./tsconfig.json",
    "package": "node esbuild.js --production",
    "build": "node esbuild.js",
    "lint": "eslint src --ext ts",
    "pretest": "npm run compile",
    "test": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "esbuild": "^0.20.0",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "gpt-tokenizer": "^2.1.2",
    "ignore": "^5.3.1",
    "micromatch": "^4.0.5",
    "ts-morph": "^21.0.1"
  }
}
